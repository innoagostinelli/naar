<div data-controller="promo-banner">
  <div class="scrim promo-scrim" data-promo-banner-target="scrim" data-action="click->promo-banner#dismiss"></div>

  <div class="modal promo-modal" data-promo-banner-target="modal" role="dialog" aria-modal="true" aria-label="Promoción">
    <button type="button" class="modal-close" data-action="promo-banner#dismiss" aria-label="Cerrar">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <div class="promo-modal-media">
      <% if banner_setting.image.attached? %>
        <%= image_tag banner_setting.image %>
      <% elsif banner_setting.video.attached? %>
        <video src="<%= url_for(banner_setting.video) %>" controls autoplay muted playsinline></video>
      <% end %>
    </div>
  </div>
</div>
