<div class="scrim" data-search-target="scrim" data-action="click->search#close"></div>

<div class="search-overlay" data-search-target="panel" role="search" aria-label="Buscar productos">
  <div class="search-overlay-head shell">
    <%= form_with url: search_path, method: :get,
          data: { search_target: "form", turbo_frame: "search_preview_frame" } do |f| %>
      <%= f.text_field :q, placeholder: "Buscar Productos", autocomplete: "off",
            data: { search_target: "input", action: "input->search#debounceSubmit" } %>
    <% end %>
    <button type="button" class="icon-btn" data-action="click->search#close" aria-label="Cerrar búsqueda">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="search-overlay-body shell">
    <%= turbo_frame_tag "search_preview_frame" do %>
      <%= render "search/results", products: [], query: "", total: 0, preview: true %>
    <% end %>
  </div>
</div>
