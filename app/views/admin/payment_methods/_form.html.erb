<%= form_with model: [:admin, payment_method] do |f| %>
  <div class="card">
    <div class="card-header"><h3 class="card-title">Método de pago</h3></div>
    <div class="card-body">
      <% if payment_method.errors.any? %>
        <div class="alert alert-danger mb-4">
          <ul class="mb-0">
            <% payment_method.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        </div>
      <% end %>

      <div class="row g-3">
        <div class="col-md-8">
          <%= f.label :name, "Nombre", class: "form-label" %>
          <%= f.text_field :name, class: "form-control", placeholder: "Pago móvil" %>
        </div>
        <div class="col-md-4">
          <%= f.label :position, "Posición", class: "form-label" %>
          <%= f.number_field :position, class: "form-control" %>
          <div class="form-text">Orden en el carrito</div>
        </div>
      </div>

      <div class="form-check form-switch mt-3">
        <%= f.check_box :enabled, class: "form-check-input" %>
        <%= f.label :enabled, "Habilitado (aparece como opción en el carrito)", class: "form-check-label" %>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2 mt-3">
    <%= f.submit payment_method.new_record? ? "Crear método de pago" : "Guardar cambios", class: "btn btn-naar" %>
    <%= link_to "Cancelar", admin_payment_methods_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
