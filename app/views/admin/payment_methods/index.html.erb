<% content_for :page_title, "Métodos de pago" %>
<% content_for :topbar_actions do %>
  <%= link_to new_admin_payment_method_path, class: "btn btn-naar" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Nuevo método de pago
  <% end %>
<% end %>

<div class="card">
  <div class="table-responsive">
    <table class="table table-vcenter table-hover card-table">
      <thead>
        <tr>
          <th class="w-1 text-center">Pos.</th>
          <th>Nombre</th>
          <th>Estado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @payment_methods.each do |payment_method| %>
          <tr>
            <td class="text-center text-muted"><%= payment_method.position %></td>
            <td class="fw-semibold"><%= payment_method.name %></td>
            <td>
              <% if payment_method.enabled? %>
                <span class="badge-status status-active">Habilitado</span>
              <% else %>
                <span class="badge-status status-draft">Deshabilitado</span>
              <% end %>
            </td>
            <td>
              <div class="admin-actions justify-content-end">
                <%= link_to "Editar", edit_admin_payment_method_path(payment_method), class: "btn btn-sm btn-ghost" %>
                <%= button_to (payment_method.enabled? ? "Deshabilitar" : "Habilitar"),
                      toggle_admin_payment_method_path(payment_method),
                      method: :patch,
                      class: "btn btn-sm btn-outline-secondary" %>
                <%= button_to "Eliminar", admin_payment_method_path(payment_method),
                      method: :delete,
                      form: { data: { turbo_confirm: "¿Eliminar #{payment_method.name}? Los pedidos ya realizados con este método no se ven afectados." } },
                      class: "btn btn-sm btn-danger-ghost" %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @payment_methods.empty? %>
          <tr>
            <td colspan="4" class="text-center text-muted py-4">No hay métodos de pago todavía.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
