<% field_suffix = variant.persisted? ? variant.id : "new" %>
<tr class="d-none"
    data-variant-rows-target="<%= variant.persisted? ? "formRow" : "newRow" %>"
    data-variant-id="<%= variant.id %>">
  <%= form_with model: variant,
        url: (variant.persisted? ? admin_product_variant_path(product, variant) : admin_product_variants_path(product)) do |f| %>
    <td>
      <div class="d-flex align-items-center gap-2">
        <%= f.color_field :color_hex,
              class: "form-control form-control-color",
              id: "color_picker_#{field_suffix}",
              onchange: "document.getElementById('color_hex_text_#{field_suffix}').value=this.value" %>
        <%= f.text_field :color_name, class: "form-control form-control-sm", placeholder: "Nombre del color", id: "product_variant_color_name_#{field_suffix}" %>
      </div>
      <%= f.text_field :color_hex,
            class: "form-control form-control-sm mt-1",
            id: "color_hex_text_#{field_suffix}",
            placeholder: "#211218",
            onchange: "document.getElementById('color_picker_#{field_suffix}').value=this.value" %>
    </td>
    <td>
      <%= f.select :size, %w[XS S M L XL XXL Único],
            { prompt: "Talla" }, { class: "form-select form-select-sm", id: "product_variant_size_#{field_suffix}" } %>
    </td>
    <td><%= f.text_field :sku, class: "form-control form-control-sm", placeholder: "Opcional", id: "product_variant_sku_#{field_suffix}" %></td>
    <td><%= f.number_field :stock, class: "form-control form-control-sm", id: "product_variant_stock_#{field_suffix}" %></td>
    <td>
      <div class="admin-actions justify-content-end">
        <%= f.submit variant.persisted? ? "Guardar" : "Agregar", class: "btn btn-sm btn-naar" %>
        <% if variant.persisted? %>
          <button type="button" class="btn btn-sm btn-ghost" data-action="variant-rows#cancelEdit" data-variant-id="<%= variant.id %>">Cancelar</button>
        <% else %>
          <button type="button" class="btn btn-sm btn-ghost" data-action="variant-rows#cancelNew">Cancelar</button>
        <% end %>
      </div>
    </td>
  <% end %>
</tr>
