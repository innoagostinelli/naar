<% field_suffix = variant.persisted? ? variant.id : "new" %>
<% form_id = "variant_form_#{field_suffix}" %>
<tr class="d-none"
    data-variant-rows-target="<%= variant.persisted? ? "formRow" : "newRow" %>"
    data-variant-id="<%= variant.id %>">
  <td>
    <div class="d-flex align-items-center gap-2">
      <%= color_field_tag "product_variant[color_hex]", variant.color_hex,
            class: "form-control form-control-color",
            id: "color_picker_#{field_suffix}",
            form: form_id,
            onchange: "document.getElementById('color_hex_text_#{field_suffix}').value=this.value" %>
      <%= text_field_tag "product_variant[color_name]", variant.color_name,
            class: "form-control form-control-sm", placeholder: "Nombre del color",
            id: "product_variant_color_name_#{field_suffix}", form: form_id %>
    </div>
    <%= text_field_tag "product_variant[color_hex]", variant.color_hex,
          class: "form-control form-control-sm mt-1",
          id: "color_hex_text_#{field_suffix}",
          placeholder: "#211218",
          form: form_id,
          onchange: "document.getElementById('color_picker_#{field_suffix}').value=this.value" %>
  </td>
  <td>
    <%= select_tag "product_variant[size]",
          options_for_select(%w[XS S M L XL XXL Único], variant.size),
          prompt: "Talla", class: "form-select form-select-sm", id: "product_variant_size_#{field_suffix}", form: form_id %>
  </td>
  <td><%= text_field_tag "product_variant[sku]", variant.sku, class: "form-control form-control-sm", placeholder: "Opcional", id: "product_variant_sku_#{field_suffix}", form: form_id %></td>
  <td><%= number_field_tag "product_variant[stock]", variant.stock, class: "form-control form-control-sm", id: "product_variant_stock_#{field_suffix}", form: form_id %></td>
  <td>
    <div class="admin-actions justify-content-end">
      <%= submit_tag variant.persisted? ? "Guardar" : "Agregar", class: "btn btn-sm btn-naar", form: form_id %>
      <% if variant.persisted? %>
        <button type="button" class="btn btn-sm btn-ghost" data-action="variant-rows#cancelEdit" data-variant-id="<%= variant.id %>">Cancelar</button>
      <% else %>
        <button type="button" class="btn btn-sm btn-ghost" data-action="variant-rows#cancelNew">Cancelar</button>
      <% end %>
    </div>
  </td>
</tr>
