<% content_for :page_title, "Productos eliminados" %>

<%= render "admin/shared/filter_bar", q: @q, url: deleted_admin_products_path, fields: [
  { attr: :name_unaccent_cont, type: :search, label: "Buscar", col: 4 },
] %>

<div class="card" data-controller="thumb-preview">
  <div class="table-responsive">
    <table class="table table-vcenter table-hover card-table">
      <thead>
        <tr>
          <th class="admin-thumb-col"></th>
          <th>Nombre</th>
          <th>Categoría</th>
          <th>Precio</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td><%= render "admin/products/thumbnail", product: product %></td>
            <td class="fw-semibold"><%= product.name %></td>
            <td class="text-muted"><%= product.category.name %></td>
            <td>$<%= number_with_delimiter(product.price.to_i) %></td>
            <td>
              <div class="admin-actions justify-content-end">
                <%= button_to "Restaurar", restore_admin_product_path(product),
                      method: :patch,
                      class: "btn btn-sm btn-naar" %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @products.empty? %>
          <tr>
            <td colspan="5" class="text-center text-muted py-4">No hay productos eliminados.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="d-flex justify-content-center mt-3">
  <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
</div>
