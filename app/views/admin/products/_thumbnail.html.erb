<%# Miniatura del listado. Si la variante ya está generada se usa la URL directa
    de R2 (sin pasar por Rails); si no, la ruta de Active Storage que la genera. %>
<% if (img = product.thumbnail_image) %>
  <% thumb = img.image.variant(:thumb) %>
  <% preview = img.image.variant(:card) %>
  <%# La imagen grande no se descarga hasta que se pasa el mouse (thumb-preview). %>
  <%= image_tag thumb.url || thumb, alt: "", width: 40, height: 40, loading: "lazy", decoding: "async", class: "admin-thumb",
        data: { preview_url: preview.url || url_for(preview),
                action: "pointerenter->thumb-preview#show pointerleave->thumb-preview#hide click->thumb-preview#toggle" } %>
<% else %>
  <span class="admin-thumb admin-thumb-empty" title="Sin fotos">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/></svg>
  </span>
<% end %>
