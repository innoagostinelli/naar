<% content_for :page_title, "Banner publicitario" %>

<%= form_with model: @banner_setting, url: admin_banner_setting_path, method: :patch,
      multipart: true, data: { controller: "direct-upload" } do |f| %>
  <div class="card">
    <div class="card-header"><h3 class="card-title">Banner (pop-up en la tienda)</h3></div>
    <div class="card-body">
      <% if @banner_setting.errors.any? %>
        <div class="alert alert-danger mb-4">
          <ul class="mb-0">
            <% @banner_setting.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-check form-switch mb-4">
        <%= f.check_box :active, class: "form-check-input" %>
        <%= f.label :active, "Banner activo (se muestra al entrar a la tienda)", class: "form-check-label" %>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :image, "Imagen", class: "form-label" %>

          <% if @banner_setting.image.attached? %>
            <div class="mb-2">
              <%= image_tag @banner_setting.image.variant(resize_to_limit: [ 240, 240 ]), style: "max-width:200px; border-radius:8px;" %>
            </div>
            <div class="form-check mb-2">
              <input type="checkbox" name="banner_setting[remove_image]" value="1" class="form-check-input" id="remove_image">
              <label class="form-check-label" for="remove_image">Quitar imagen actual</label>
            </div>
          <% end %>

          <%= f.file_field :image, class: "form-control", accept: "image/*", direct_upload: true,
                data: { direct_upload_target: "input" } %>
          <div class="progress mt-2" style="display:none; height:6px;" data-direct-upload-target="progressWrap">
            <div class="progress-bar" role="progressbar" style="width:0%" data-direct-upload-target="progressBar"></div>
          </div>
          <div class="form-text" data-direct-upload-target="status">
            <%= @banner_setting.image.attached? ? "Dejar vacío para mantener la imagen actual." : "" %>
          </div>
        </div>

        <div class="col-md-6">
          <%= f.label :video, "Video", class: "form-label" %>

          <% if @banner_setting.video.attached? %>
            <div class="mb-2">
              <video src="<%= url_for(@banner_setting.video) %>" style="max-width:200px; border-radius:8px;" controls muted></video>
            </div>
            <div class="form-check mb-2">
              <input type="checkbox" name="banner_setting[remove_video]" value="1" class="form-check-input" id="remove_video">
              <label class="form-check-label" for="remove_video">Quitar video actual</label>
            </div>
          <% end %>

          <%= f.file_field :video, class: "form-control", accept: "video/*", direct_upload: true,
                data: { direct_upload_target: "input" } %>
          <div class="form-text">
            <%= @banner_setting.video.attached? ? "Dejar vacío para mantener el video actual." : "" %>
          </div>
        </div>
      </div>

      <div class="form-text mt-3">
        Si se cargan imagen y video a la vez, en la tienda se muestra la imagen. El banner solo aparece si está activo <strong>y</strong> tiene al menos un archivo cargado.
      </div>
    </div>
  </div>

  <div class="d-flex gap-2 mt-3">
    <%= f.submit "Guardar cambios", class: "btn btn-naar", data: { direct_upload_target: "submit" } %>
    <%= link_to "Ver en la tienda", root_path, target: "_blank", rel: "noopener", class: "btn btn-outline-secondary" %>
  </div>
<% end %>
